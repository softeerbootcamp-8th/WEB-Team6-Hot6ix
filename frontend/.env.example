# axios baseURL.
# dev: 비워두면 상대경로(/api/...)로 호출되어 vite.config.ts 의 프록시가 백엔드로 전달 (CORS 불필요)
# prod: 실제 API 호스트를 지정 (예: https://api.upbid.com)
VITE_API_BASE_URL=

# 카카오 OAuth 앱의 REST API 키 (카카오 개발자 콘솔에서 발급)
VITE_KAKAO_CLIENT_ID=

# 카카오 OAuth 리다이렉트 URI (카카오 개발자 콘솔에 등록된 값과 일치해야 함)
# 로컬: http://localhost:8080/api/v1/oauth/kakao/callback
# prod: https://api.upbid.com/api/v1/oauth/kakao/callback
VITE_KAKAO_REDIRECT_URI=

# 개발용 UI(우하단 DEV 패널·라우터 devtools·경매방 DEV 버튼) 초기 상태.
# off 로 두면 처음부터 숨긴 채 시작한다. 실행 중에는 Cmd/Ctrl + Shift + D 로 토글.
# 프로덕션 빌드에는 애초에 포함되지 않는다.
VITE_DEV_TOOLS=
