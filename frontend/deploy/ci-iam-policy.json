{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SyncFrontendBundle",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::upbid-frontend",
        "arn:aws:s3:::upbid-frontend/*"
      ]
    },
    {
      "Sid": "InvalidateCloudFront",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::603224628947:distribution/E17BE3ZTNT6VTF"
    }
  ]
}
