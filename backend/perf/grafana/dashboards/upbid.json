          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "upbid-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{run=\"$run\", uri!=\"/actuator/prometheus\", uri!~\".*subscribe\"}[30s]))) * 1000",
