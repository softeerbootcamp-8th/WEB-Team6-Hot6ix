upstream app {
    server 10.0.1.88:8080;
    keepalive 128;
    keepalive_timeout 15s;
}

server {
    server_name api.upbid.store;

    location / {
        include /etc/nginx/snippets/upbid-proxy.conf;
    }

    # SSE 는 끝나지 않는 스트림이라 proxy_read_timeout 기본값 60초에 걸린다. 지금은
    # heartbeat 가 30초라 그 전에 데이터가 흘러 살아 있지만, heartbeat 주기를 늘리는
    # 대조 실험을 하면 서버가 아니라 nginx 가 끊어서 그 실험 자체를 못 한다.
    # 앱의 emitter 타임아웃(upbid.sse.emitter-timeout-ms, 기본 1시간)에 맞춘다.
    #
    # 나머지 경로는 기본값 60초로 둔다. 다 늘리면 앱이 멈춘 요청까지 오래 붙들고 있는다.
    location ~ ^/api/v1/auction-rooms/share/[^/]+/subscribe$ {
        include /etc/nginx/snippets/upbid-proxy.conf;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # dev-login 은 비밀번호 없이 세션을 주는 문이라 측정 서버에서만 부를 수 있게 한다.
    # 앱의 토큰 게이트가 1차이고 이게 2차다 (DevPageGuard 가 방어선을 둘 두는 것과 같은 이유).
    #
    # 3.36.33.153 은 이 배스천 자신이다. 측정 EC2(10.0.1.119)가 프라이빗 서브넷이라 여기를
    # NAT 로 쓰고, 그래서 요청이 도착할 때 출발지가 배스천으로 보인다 (access.log 로 확인).
    # 즉 이 줄은 "VPC 안에서 나간 요청만" 이라는 뜻이고 인터넷에서는 못 닿는다.
    # 실제로 access.log 에 /wp-admin 을 훑는 스캐너가 계속 붙는다.
    #
    # 쿼리스트링(?key=bidder-1)은 location 매칭에 안 들어가므로 = 정확히 일치로 충분하다.
    location = /api/v1/auth/dev-login {
        allow 3.36.33.153;
        deny all;

        include /etc/nginx/snippets/upbid-proxy.conf;
    }

    # /actuator 에는 인증이 없다. AuthInterceptor 가 /api/v1 아래만 보기 때문에, 노출을 켜면
    # 힙과 DB 풀, 엔드포인트 목록이 그대로 공개된다.
    #
    # 측정 서버는 이 프록시가 아니라 app EC2 사설 IP(10.0.1.88:8080)를 직접 긁는다. 그래서
    # 여기로 들어올 이유가 없고, allow 를 하나도 두지 않는다. 사설 IP 쪽은 보안 그룹으로 막는다.
    location /actuator {
        deny all;
    }

    listen 443 ssl http2; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/api.upbid.store/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.upbid.store/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = api.upbid.store) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name api.upbid.store;
    return 404; # managed by Certbot


}
