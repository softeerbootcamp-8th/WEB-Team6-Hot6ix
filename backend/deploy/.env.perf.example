# 부하 측정 창구에만 앱 서버에 두는 파일이다 (이슈 #266).
#
# /home/ubuntu/app/.env.perf 로 복사해서 값을 채우고 `docker compose up -d` 를 한다.
# **CD 가 안 건드리는 파일이라 배포해도 남는다.** .env 는 배포할 때마다 새로 쓰여서
# 손으로 넣은 줄이 사라지는데, 이 파일은 그렇지 않다.
#
# 측정이 끝나면 파일을 지우고 다시 올린다. 파일이 없으면 앱이 기본값으로 떠서
# actuator 는 health 만, dev-login 은 빈 자체가 안 생긴다.
#
#   rm .env.perf && docker compose up -d
#
# 지금 열려 있는지 확인:  ls /home/ubuntu/app/.env.perf

# 관측 지표를 연다. 열기 전에 배스천 nginx 의 `location /actuator { deny all; }` 이
# 살아 있는지 확인한다. 앱 8080 은 측정 서버 보안 그룹으로만 막혀 있다.
ACTUATOR_EXPOSURE=health,metrics,prometheus

# dev-login 을 여는 열쇠. 비워 두면 엔드포인트 자체가 안 생긴다.
# 서버에서 만든다:  openssl rand -hex 16
# 측정 서버의 ~/perf.env 에 같은 값을 넣어야 k6 와 seed.sh 가 통과한다.
DEV_LOGIN_TOKEN=

# 아래는 대조 실험에서 한 번에 하나만 바꾼다. 안 적으면 기본값 그대로다.
#
# PERF_RUN_ID 는 안 적어도 된다. 안 적으면 앱이 unknown 을 붙이고 run.sh 의
# --run-label 기본값도 unknown 이라 그대로 맞는다. 계단은 구간 시각으로 갈린다.
#
# PERF_RUN_ID=prod-2026-08-11
# DB_POOL_SIZE=10
# SCHEDULER_POOL_SIZE=4
# SSE_HEARTBEAT_MS=30000
# SSE_TIMEOUT_MS=3600000
#
# 시나리오 2(한 방 물품 20개)를 배포에서 돌리려면 이걸 올려야 한다. 서비스 규칙이 3이라
# 그대로는 못 돈다. 올린 상태로 잰 줄은 note.md 에 "제한을 푼 상태"라고 적는다.
# MAX_IN_PROGRESS_PER_ROOM=50
#
# 로그를 줄인다. prod 는 INFO 라 입찰 1건마다 DomainEventSseListener 가 응답 경로 안에서
# 한 줄을 쓴다. 로컬 perf 가 warn 인 이유와 같다.
# LOG_LEVEL=warn
# APP_LOG_LEVEL=warn
